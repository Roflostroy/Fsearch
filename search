#!/bin/bash
while true;
 do
echo "█████  ████ █████  ███  ████   ███  █   █ "
echo "█     █     █     █   █ █   █ █     █   █ "
echo "████   ███  ████  █████ ████  █     █████ "
echo "█         █ █     █   █ █  █  █     █   █ "
echo "█     ████  █████ █   █ █   █  ███  █   █ "
echo " "
echo "============================================================================="
    echo "Введите, что хотите сделать"
    echo "Help"
    echo "Search"
    echo "Clear"
    read choice
           if [[ "$choice" == "Help" ]]; then
        echo "============================================================================="
        echo "                              СПРАВКА"
        echo "============================================================================="
        echo "Доступные команды главного меню:"
        echo ""
        echo "  Help    - показать эту справку"
        echo "  Search  - перейти в меню поиска файлов"
        echo ""
        echo "Команды поиска после ввода Search:"
        echo ""
        echo "  file - поиск  по имени"
        echo "         Пример: введите file, затем name.txt"
        echo ""
        echo "  ext  - поиск  по расширению"
        echo "         Пример: введите ext, затем txt"
        echo ""
        echo "  time - поиск изменённых за последние N дней"
        echo "         Пример: введите time, затем 7"
        echo ""
        echo "  size - поиск по размеру в формате команды find"
        echo "         Примеры: +10M — больше 10 МБ"
        echo "                  -1G  — меньше 1 ГБ"
        echo "                  1024c — ровно 1024 байта"
        echo ""
        echo "  perm - поиск по правам доступа в формате find"
        echo "         Примеры: 644, 755, -u+w"
        echo ""
        echo "Важно:"
        echo "  - Команды Help и Search вводятся с заглавной буквы."
        echo "  - Поиск выполняется по всей файловой системе /."
        echo "  - file, ext, time, size и perm ищут только файлы."
        echo "  - dir ищет только каталоги."
        echo "  - Ошибки доступа скрываются благодаря 2>/dev/null."
        echo "  - Для остановки скрипта нажмите Ctrl+C."
        echo "============================================================================="
    fi
    if  [[ "$choice" == "Search" ]];
    then
        echo "============================================================================"
        echo "Введите, поиск чего вы хотите сделать"
        echo "file - название"
        echo "ext - расширение"
        echo "time -  время изменения (В днях)"
        echo "size - Размер "
        echo "perm - Права доступа"
        read file
        if [[ "$file" == "file" ]];
        then
        echo "Введите имя"
        read name
        echo "Файлы: "
        find / -type f -iname "$name" 2>/dev/null
        echo "Каталоги: "
        find / -type d -iname "$name" 2>/dev/null
        echo "============================================================================"
        fi
        if [[ "$file" == "ext" ]];
        then
        echo "Введи расширение"
        read ext
        find / -type f -iname "*.$ext" 2>/dev/null
        echo "============================================================================"
        fi
        if [[ "$file" == "time" ]];
        then
        echo "Введите время (в днях)"
        read time
        echo "Файлы: "
        find / -type f -mtime -$time 2>/dev/null
        echo "Каталоги: "
        find / -type d -mtime -$time 2>/dev/null
        echo "============================================================================"
        fi
        if [[ "$file" == "size" ]];
        then
        echo "Введите размер"
        read size
        echo "Файлы: "
        find / -type f -size "$size" 2>/dev/null
        echo "Каталоги: "
        find / -type  d -size "$size" 2>/dev/null
        echo "============================================================================"
        fi
        if [[ "$file" == "perm" ]];
        then
        echo "Введите код прав доступа"
        read perm
        echo "Файлы: "
        find / -type f -perm "$perm" 2>/dev/null
        echo "Каталоги: "
        find / -type d -perm "$perm" 2>/dev/null
        echo "============================================================================"
        fi  	
    fi
    if [[ "$choice" == 'Clear' ]];
    then
    clear
    fi
done
